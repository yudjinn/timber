{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timber",
  "mainBinaryName": "timber",
  "identifier": "dev.timber.viewer",
  "build": {
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../.." },
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../.." },
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Timber",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Jacob Rodgers",
    "shortDescription": "Device tree viewer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
