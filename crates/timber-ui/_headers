# Cloudflare Pages caching (D-036): the page is checked on every load, while the build
# files, whose names carry a content hash, are cached for good.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/timber-ui-*
  Cache-Control: public, max-age=31536000, immutable
/style-*
  Cache-Control: public, max-age=31536000, immutable
