# Caching on Cloudflare (D-036). Static assets are already served "cache, but revalidate
# every time" (max-age=0, must-revalidate, with an ETag), which is right for the page. The
# build files carry a content hash in their names, so they can be cached for good.
/timber-ui-*
  Cache-Control: public, max-age=31536000, immutable
/style-*
  Cache-Control: public, max-age=31536000, immutable
