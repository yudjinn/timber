/dts-v1/;
#include "soc.dtsi"

#define BOARD_NAME "Acme Test Board"
#define CAT(a, b) a##b

/ {
	model = BOARD_NAME;
	compatible = "acme,board", "acme,soc";

	chosen {
		stdout-path = "serial0:1500000n8";
		bootargs = "console=ttyS0 \"quoted\"\tend";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 (512 * 1024 * 1024)>;
	};

	vcc3v3: regulator-vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	leds {
		compatible = "gpio-leds";
		led-0 {
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			label = "status";
			linux,default-trigger-id = <CAT(0x, 1f)>;
		};
	};

	misc {
		bytes = [de ad be ef 00];
		chars = <'A' '\n' '\x41'>;
		wide = /bits/ 64 <0x123456789abcdef0>;
		half = /bits/ 16 <0xffff 1>;
		neg = <(-2)>;
		expr = <(1 << 4 | 3) (10 % 3) (7 > 3 ? 100 : 200)>;
		path = &uart0, &{/soc/i2c@fe5a0000};
		mixed = "a", <1 &vcc3v3>, [aa];
		empty-string = "";
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_xfer>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_xfer>;
	status = "okay";

	pmic@20 {
		compatible = "acme,pmic";
		reg = <0x20>;
		vcc-supply = <&vcc3v3>;
		interrupts-extended = <&gic GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>;
	};
};

&soc {
	/delete-node/ removed@0;
};

&cpu1 {
	/delete-property/ enable-method;
};
